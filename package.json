{
  "name": "retainly",
  "packageManager": "yarn@4.9.2",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "lint": "eslint \"apps/**/*.ts\"",
    "jscpd": "jscpd apps/",
    "knip": "knip --production",
    "test": "vitest run",
    "db:up": "docker compose --project-directory . -f docker/docker-compose.yml -f docker/docker-compose.dev.yml up -d",
    "db:down": "docker compose --project-directory . -f docker/docker-compose.yml -f docker/docker-compose.dev.yml down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jscpd": "^5.2.0",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.5.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
